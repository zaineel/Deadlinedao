# Solana Configuration
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_ESCROW_PRIVATE_KEY=[1,2,3,...]  # Your escrow wallet private key as array

# Supabase Configuration
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Snowflake Configuration
SNOWFLAKE_ACCOUNT=your_account
SNOWFLAKE_USERNAME=your_snowflake_user  # required; no default
SNOWFLAKE_WAREHOUSE=COMPUTE_WH  # optional; defaults to COMPUTE_WH
# base64 of the PKCS8 PEM private key; if unset, .snowflake-keys/rsa_key.p8 is read instead
SNOWFLAKE_PRIVATE_KEY=

# Cloudflare R2 Configuration
CLOUDFLARE_R2_ENDPOINT=https://xxx.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY=your_access_key
CLOUDFLARE_R2_SECRET_KEY=your_secret_key
CLOUDFLARE_R2_BUCKET=deadlinedao-proofs
CLOUDFLARE_R2_PUBLIC_URL=https://pub-xxx.r2.dev

# Admin
ADMIN_API_KEY=long_random_secret  # required for /admin and /api/admin/*
DEMO_MODE=false  # server-only; true skips on-chain stake verification. Never enable in production
# NEXT_PUBLIC_DEMO_MODE=false  # legacy fallback for DEMO_MODE; do not set in production
CRON_SECRET=another_long_random_secret  # Vercel sends it as a Bearer token to /api/cron/*

# Wallet sign-in sessions: min 32 random chars (e.g. `openssl rand -base64 48`).
# No default; auth fails closed without it.
SESSION_SECRET=

# Notifications (optional; console logging is used when unset)
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=

# Feature flags (all default off; set to true to enable)
FEATURE_DISPUTES=false
FEATURE_TEAMS=false
FEATURE_ORGS=false
FEATURE_PUSH=false
FEATURE_GOVERNANCE=false

# Governance tuning (all optional; values are clamped to safe ranges). Needs FEATURE_GOVERNANCE and FEATURE_DISPUTES.
GOVERNANCE_MIN_COMPLETED_GOALS=3  # completed goals needed to be a voter (1-100)
GOVERNANCE_PANEL_SIZE=5  # voters drawn per dispute (3-25)
GOVERNANCE_QUORUM=3  # votes needed for a panel decision, capped at panel size (2-25)
GOVERNANCE_VOTING_WINDOW_HOURS=48  # (1-168)
GOVERNANCE_REWARD_SHARE_BPS=5000  # share of the bond paid to majority voters when upheld (0-10000)

# Mobile app: App Store link shown on the public share page (optional)
NEXT_PUBLIC_IOS_APP_URL=
