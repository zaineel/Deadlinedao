# Solana Configuration
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_ESCROW_PRIVATE_KEY=[1,2,3,...]  # Your escrow wallet private key as array

# Supabase Configuration
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Snowflake Configuration
SNOWFLAKE_ACCOUNT=your_account
SNOWFLAKE_API_ENDPOINT=your_api_endpoint
SNOWFLAKE_JWT_TOKEN=your_jwt_token

# Cloudflare R2 Configuration
CLOUDFLARE_R2_ENDPOINT=https://xxx.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY=your_access_key
CLOUDFLARE_R2_SECRET_KEY=your_secret_key
CLOUDFLARE_R2_BUCKET=deadlinedao-proofs
CLOUDFLARE_R2_PUBLIC_URL=https://pub-xxx.r2.dev

# Admin
ADMIN_API_KEY=long_random_secret  # required for /admin and /api/admin/*
DEMO_MODE=false  # server-only; true skips on-chain stake verification. Never enable in production
CRON_SECRET=another_long_random_secret  # Vercel sends it as a Bearer token to /api/cron/*

# Wallet sign-in sessions: min 32 random chars (e.g. `openssl rand -base64 48`).
# No default; auth fails closed without it.
SESSION_SECRET=

# Notifications (optional; console logging is used when unset)
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=
