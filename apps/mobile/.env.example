# Base URL of the deployed DeadlineDAO web app (no trailing slash).
# On a physical iPhone, localhost will not work: use your LAN IP or the Vercel URL.
EXPO_PUBLIC_API_URL=https://your-deployment.vercel.app
# devnet | mainnet-beta (passed to Phantom; the web app runs on devnet)
EXPO_PUBLIC_SOLANA_CLUSTER=devnet
